# Google Apps Script Web App URL (state sync + production AI proxy).
# Leave empty to run local-only with localStorage + optional browser Gemini.
VITE_SHEETS_ENDPOINT=""

# Local/dev only. Do NOT set this in production — key is exposed in the JS bundle.
# Production: set Script Properties on the Apps Script project instead:
#   GEMINI_API_KEY = <your key>
#   GEMINI_MODEL   = gemini-flash-lite-latest   (optional)
VITE_GEMINI_API_KEY=""
VITE_GEMINI_MODEL="gemini-flash-lite-latest"
