# Server-side Gemini key (required for real AI on mine/analyze/etc).
# Never prefix with VITE_ — that ships the key to the browser.
GEMINI_API_KEY=""

# Optional model overrides (defaults are fine for free-tier pilot).
GEMINI_MODEL_FAST="gemini-flash-lite-latest"
GEMINI_MODEL_REASONING="gemini-flash-lite-latest"

# Optional org label injected into AI prompts.
ORG_NAME="Finance Directorate"

# Google Apps Script Web App URL — primary shared DB (profiles + catalogue sync).
# Deploy docs/google-apps-script.js as a Web App, then paste the /exec URL here.
# Also set this in Vercel Project Settings → Environment Variables (Production)
# because VITE_ vars are baked in at build time.
VITE_SHEETS_ENDPOINT=""

# Optional Postgres remote auth (OFF by default — this project uses Sheets).
# Only set to "true" if you intentionally switch to Neon instead of Spreadsheet.
VITE_ENABLE_REMOTE_AUTH="false"
DATABASE_URL=""
AUTH_TOKEN_SECRET=""
