# Server-side Gemini key (required for real AI on mine/analyze/etc).
# Never prefix with VITE_ — that ships the key to the browser.
GEMINI_API_KEY=""

# Optional model overrides (defaults are fine for free-tier pilot).
GEMINI_MODEL_FAST="gemini-flash-lite-latest"
GEMINI_MODEL_REASONING="gemini-flash-lite-latest"

# Optional org label injected into AI prompts.
ORG_NAME="Finance Directorate"

# Optional — used by some AI Studio / Cloud Run hosts.
APP_URL=""

# DATABASE_URL: Postgres for the remote backend (api/blueprint.ts).
# Neon via Vercel Storage injects this automatically in production.
# For local: copy from Neon dashboard into .env.local.
DATABASE_URL=""

# AUTH_TOKEN_SECRET: signs login sessions (api/_lib/auth.ts).
# Generate with: openssl rand -hex 32
AUTH_TOKEN_SECRET=""

# VITE_ENABLE_REMOTE_AUTH: "true" switches Onboarding/LockScreen to Postgres RemoteLogin.
# Must be set in Vercel env (VITE_ prefix is baked into the browser bundle at build time).
VITE_ENABLE_REMOTE_AUTH="true"
# With remote auth on: Login + Register hit Postgres (api/blueprint),
# not Google Sheets. Sheets path was replaced by Neon Postgres.
